+function patchZcashLightClientFfi(path: string): void {
+  const cargoTomlPath = join(path, 'rust', 'Cargo.toml')
+  const cargoLockPath = join(path, 'rust', 'Cargo.lock')
+  const cargoToml = readFileSync(cargoTomlPath, 'utf8')
+
+  const replacements: Array<[string, string]> = [
+    ['zcash_address', STABLE_ZCASH_COMMIT],
+    ['zcash_client_backend', STABLE_ZCASH_COMMIT],
+    ['zcash_client_sqlite', STABLE_ZCASH_COMMIT],
+    ['zcash_primitives', STABLE_ZCASH_COMMIT],
+    ['zcash_proofs', STABLE_ZCASH_COMMIT],
+    ['verus_zfunc', VERUS_ZFUNC_COMMIT]
+  ]
+
+  let patchedCargoToml = cargoToml
+  for (const [name, rev] of replacements) {
+    const from = `${name} = { git = "https://github.com/who-biz/librustzcash", branch = "ka_agree-security-fixes" }`
+    const to = `${name} = { git = "https://github.com/who-biz/librustzcash", rev = "${rev}" }`
+    patchedCargoToml = patchedCargoToml.replace(from, to)
+  }
+
+  if (patchedCargoToml === cargoToml) {
+    throw new Error('Expected to pin zcash-light-client-ffi Rust dependencies')
+  }
+
+  writeFileSync(cargoTomlPath, patchedCargoToml)
+  if (existsSync(cargoLockPath)) rmSync(cargoLockPath)
+}
